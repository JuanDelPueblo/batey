{
  "name": "batey-frontend",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ng build",
    "format": "prettier --write \"src/**/*.html\" \"src/**/*.scss\"",
    "format:check": "prettier --check \"src/**/*.html\" \"src/**/*.scss\"",
    "lint": "npm run format:check && npm run lint:styles",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "test": "ng test --watch=false",
    "start": "ng serve",
    "fake-backend": "node ../backend/fake/server.mjs",
    "dev": "node ../backend/fake/dev.mjs"
  },
  "dependencies": {
    "@angular/cdk": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/material": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@fontsource-variable/roboto": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.0.13",
    "material-symbols": "0.47.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.7",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
